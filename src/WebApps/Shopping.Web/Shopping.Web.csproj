    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>25af54ec-5196-47f9-ba8b-640d0b9af8bf</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
