    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageReference Include="Refit.Reflection" Version="16.4.0" />
  </ItemGroup>

</Project>
